# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# Embedding Configuration
# Provider: 'ollama' (uses Ollama API) or 'chroma_default' (uses fast built-in ONNX MiniLM, zero extra setup)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Database & Storage
CHROMA_PERSIST_DIRECTORY=./data/chroma
DOCUMENTS_DIRECTORY=./data/documents

# Retrieval & Reranking Weights
WEIGHT_SEMANTIC=0.35
WEIGHT_KEYWORD=0.25
WEIGHT_COMPLETENESS=0.30
WEIGHT_SECTION=0.10
COMPLETE_CODE_BOOST=0.40
MAX_CONTEXT_TOKENS=2500
TOP_K_RETRIEVAL=15
TOP_K_RERANKED=5

# Server Configuration
HOST=0.0.0.0
PORT=8000
